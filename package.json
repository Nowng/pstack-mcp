{
  "name": "pstack-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes pstack skills for local LLMs (LM Studio compatible)",
  "bin": {
    "pstack-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "install": "node scripts/setup.js",
    "build": "tsc",
    "start": "tsx src/mcp.ts",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "pstack",
    "agent-skills",
    "lm-studio",
    "llm"
  ],
  "license": "MIT"
}
